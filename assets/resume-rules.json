{
  "version": "1.0",
  "updated": "2026-07-27",
  "note": "Rule data for resume.html. This file is the single source of truth for ATS lint thresholds, section naming, and the skill taxonomy used for job-description keyword coverage. The page applies these rules in the browser; scripts/validate_resume_assets.py enforces the file's shape in CI. Contains no personal data.",
  "sections": {
    "canonical": [
      "Summary",
      "Skills",
      "Experience",
      "Projects",
      "Education",
      "Certifications"
    ],
    "synonyms": {
      "Summary": ["professional summary", "profile", "objective", "about me", "career summary"],
      "Skills": ["technical skills", "core competencies", "areas of expertise", "key skills"],
      "Experience": ["work experience", "professional experience", "employment history", "work history", "relevant experience"],
      "Projects": ["selected projects", "technical projects", "personal projects"],
      "Education": ["academic background", "education and training"],
      "Certifications": ["licenses and certifications", "credentials", "certificates"]
    },
    "risky": {
      "note": "Headings ATS parsers frequently fail to map to a known section. Prefer the canonical name.",
      "examples": ["what i bring", "my journey", "career highlights", "the story so far", "who i am", "expertise areas"]
    }
  },
  "banned_glyphs": [
    {"char": "•", "name": "bullet glyph in text", "replacement": "-", "reason": "Belongs to list markup, not bullet text; duplicates render as stray characters."},
    {"char": "–", "name": "en dash", "replacement": "-", "reason": "Older parsers emit a replacement character."},
    {"char": "—", "name": "em dash", "replacement": "-", "reason": "Older parsers emit a replacement character."},
    {"char": "‘", "name": "left single quote", "replacement": "'", "reason": "Smart quotes break plain-text extraction."},
    {"char": "’", "name": "right single quote", "replacement": "'", "reason": "Smart quotes break plain-text extraction."},
    {"char": "“", "name": "left double quote", "replacement": "\"", "reason": "Smart quotes break plain-text extraction."},
    {"char": "”", "name": "right double quote", "replacement": "\"", "reason": "Smart quotes break plain-text extraction."},
    {"char": "…", "name": "ellipsis", "replacement": "...", "reason": "Single-glyph ellipsis is dropped by some extractors."},
    {"char": "ﬁ", "name": "fi ligature", "replacement": "fi", "reason": "Ligatures corrupt keyword matching (con-fi-guration)."},
    {"char": "ﬂ", "name": "fl ligature", "replacement": "fl", "reason": "Ligatures corrupt keyword matching."},
    {"char": " ", "name": "non-breaking space", "replacement": " ", "reason": "Tokenizers may join adjacent words."},
    {"char": "​", "name": "zero-width space", "replacement": "", "reason": "Invisible character splits keywords silently."}
  ],
  "date_formats": [
    {"name": "Mon YYYY", "pattern": "^[A-Z][a-z]{2} [0-9]{4}$", "example": "Mar 2019"},
    {"name": "Month YYYY", "pattern": "^[A-Z][a-z]+ [0-9]{4}$", "example": "March 2019"},
    {"name": "MM/YYYY", "pattern": "^[0-9]{2}/[0-9]{4}$", "example": "03/2019"},
    {"name": "YYYY", "pattern": "^[0-9]{4}$", "example": "2019"},
    {"name": "Present", "pattern": "^Present$", "example": "Present"}
  ],
  "lint": {
    "max_resume_chars": 7000,
    "max_summary_chars": 600,
    "min_summary_chars": 180,
    "max_bullet_chars": 240,
    "min_bullet_chars": 40,
    "min_bullets_per_role": 2,
    "max_bullets_per_role": 6,
    "min_quantified_ratio": 0.4,
    "min_skills": 8,
    "max_skills": 40,
    "target_coverage": 0.7
  },
  "weak_openers": [
    "responsible for",
    "duties included",
    "helped with",
    "worked on",
    "assisted with",
    "tasked with",
    "in charge of",
    "involved in",
    "participated in",
    "familiar with"
  ],
  "strong_verbs": [
    "administered", "audited", "authored", "automated", "built", "configured",
    "cut", "delivered", "deployed", "diagnosed", "documented", "eliminated",
    "engineered", "escalated", "established", "imaged", "implemented",
